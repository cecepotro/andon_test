@using Andon.Core.Entities
@model Line
<div class="kt-modal-content max-w-[500px] w-full">
    <div class="kt-card-header px-5">
        <h3 class="kt-card-title">
            Línea
        </h3>
        <button class="kt-btn kt-btn-sm kt-btn-icon kt-btn-ghost shrink-0" data-kt-modal-dismiss="true">
            <i class="ki-filled ki-cross text-base"></i>
        </button>
    </div>

    <div class="kt-card-content flex flex-col space-y-3 p-5 kt-scrollable-y-auto">
        <input type="hidden" id="line-id" value="@((Model != null) ? Model.Id : 0)" />
        <div class="flex flex-col px-0 gap-2.5">
            <div class="flex flex-center gap-1">
                <label class="kt-form-label max-w-56">Nombre</label>
            </div>
            <input class="kt-input" id="line-name" type="text" value="@(Model?.Name)" autocomplete="off" />
        </div>
    </div>
    <div class="kt-card-footer grid gap-2.5">
        <div class="flex justify-end gap-2.5">
            <button class="kt-btn kt-btn-outline" data-kt-modal-dismiss="true">
                Cancelar
            </button>
            <button class="kt-btn kt-btn-primary" id="btn-line-save">
                Guardar
            </button>
        </div>
    </div>
</div>
<div id="line-messages" style="display:none"
     data-empty-name="El nombre es obligatorio."></div>
