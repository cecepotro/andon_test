@using Andon.Core.Entities
@using Andon.Web.Attribute
<!DOCTYPE html>
<html class="h-full" data-kt-theme="true" data-kt-theme-mode="light" dir="ltr" lang="es">
<head>
    <title>Andon</title>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1, shrink-to-fit=no" name="viewport" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="~/Content/vendors/keenicons/styles.bundle.css?v=@MvcApplication.version" rel="stylesheet" />
    <link href="~/Content/css/styles.css?v=@MvcApplication.version" rel="stylesheet" />
    <link href="~/Content/images/logos/semaforo.svg" rel="shortcut icon" />
</head>
<body class="antialiased flex h-full text-base text-foreground bg-background [--header-height:54px]">
    <div id="loadingOverlay" class="fixed top-0 left-0 right-0 bottom-0 w-full h-screen overflow-hidden bg-gray-700 opacity-75 flex flex-col items-center justify-center hidden" style="z-index: 9999">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2" data-kt-datatable-spinner="true" style="display: block;">
            @Html.Partial("_Loading")
        </div>
    </div>
    <script>
        const defaultThemeMode = 'light';
        let themeMode;

        if (document.documentElement) {
            if (localStorage.getItem('kt-theme')) {
                themeMode = localStorage.getItem('kt-theme');
            } else if (document.documentElement.hasAttribute('data-kt-theme-mode')) {
                themeMode = document.documentElement.getAttribute('data-kt-theme-mode');
            } else {
                themeMode = defaultThemeMode;
            }

            if (themeMode === 'system') {
                themeMode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }

            document.documentElement.classList.add(themeMode);
        }
    </script>

    @{
        UserAndon u = AuthUtil.GetCurrentUser();
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        <input type="hidden" name="url" id="url" value="@MvcApplication.urlSystem" />
    }

    <div class="flex grow flex-col in-data-kt-[sticky-header=on]:pt-(--header-height)">
        <header class="flex items-center transition-[height] shrink-0 bg-background h-(--header-height)" data-kt-sticky="true" data-kt-sticky-class="transition-[height] fixed z-10 top-0 left-0 right-0 shadow-xs backdrop-blur-md bg-white/70 dark:bg-background/70 border-b border-border" data-kt-sticky-name="header" data-kt-sticky-offset="100px" id="header">
            <div class="kt-container-fluid flex flex-wrap justify-between items-center lg:gap-4" id="header_container">
                <div class="flex items-center gap-2 lg:gap-5">
                    <a class="flex items-center gap-2" href="@Url.Action("Index", "Line")">
                        <img alt="Andon" class="h-8" src="~/Content/images/logos/semaforo.svg" />
                        <span class="text-base font-semibold text-mono">Andon</span>
                    </a>
                </div>

                @if (u != null) {
                    <div class="flex items-center gap-3">
                        <div data-kt-dropdown="true" data-kt-dropdown-offset="10px, 10px" data-kt-dropdown-offset-rtl="-20px, 10px" data-kt-dropdown-placement="bottom-end" data-kt-dropdown-placement-rtl="bottom-start" data-kt-dropdown-trigger="click">
                            <div class="cursor-pointer shrink-0" data-kt-dropdown-toggle="true">
                                <div class="rounded-full size-9 shrink-0 flex items-center justify-center text-white font-semibold text-sm bg-primary">
                                    @(u.Name?.Trim().Substring(0, 1).ToUpper())
                                </div>
                            </div>
                            <div class="kt-dropdown-menu w-[250px]" data-kt-dropdown-menu="true">
                                <div class="flex items-center justify-between px-2.5 py-1.5 gap-1.5">
                                    <div class="flex items-center gap-2">
                                        <div class="rounded-full size-9 shrink-0 flex items-center justify-center text-white font-semibold text-sm bg-primary">
                                            @(u.Name?.Trim().Substring(0, 1).ToUpper())
                                        </div>
                                        <div class="flex flex-col gap-1.5">
                                            <span class="text-sm text-foreground font-semibold leading-none">
                                                @u.ToString()
                                            </span>
                                            <a class="text-xs text-secondary-foreground hover:text-primary font-medium leading-none">
                                                @u.Account
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <ul class="kt-dropdown-menu-sub">
                                    <li>
                                        <div class="kt-dropdown-menu-separator"></div>
                                    </li>
                                </ul>
                                <div class="px-2.5 pt-1.5 mb-2.5 flex flex-col gap-3.5">
                                    <div class="flex items-center gap-2 justify-between">
                                        <span class="flex items-center gap-2">
                                            <i class="ki-filled ki-moon text-base text-muted-foreground"></i>
                                            <span class="font-medium text-2sm">
                                                Modo oscuro
                                            </span>
                                        </span>
                                        <input class="kt-switch" data-kt-theme-switch-state="dark" data-kt-theme-switch-toggle="true" name="check" type="checkbox" value="1" />
                                    </div>
                                    <a class="kt-btn kt-btn-outline justify-center w-full" href="@Url.Action("Logout", "Home")">
                                        Cerrar sesión
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </header>

        <div class="bg-background border-y border-t border-border mb-5 lg:mb-5">
            <div class="kt-container-fluid flex flex-wrap justify-between items-center gap-2">
                <div class="grid">
                    <div class="kt-scrollable-x-auto">
                        <div class="kt-menu gap-5 lg:gap-7.5" data-kt-menu="true">
                            <div class="kt-menu-item py-3.5 border-b border-transparent kt-menu-item-active:border-b-mono kt-menu-item-here:border-b-mono @(currentController == "Line" ? "active" : "")">
                                <a class="kt-menu-link gap-2.5" href="@Url.Action("Index", "Line")">
                                    <span class="kt-menu-title text-nowrap font-medium text-sm text-secondary-foreground kt-menu-item-active:text-mono kt-menu-item-active:font-medium kt-menu-link-hover:text-mono">
                                        Líneas
                                    </span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="container-fixed w-full flex px-0 lg:ps-4">
            <!-- Éste es el div que comentamos en lz reunión del viernes y es el que se pobla con el modal por medio de JavaScript -->
            <div class="kt-modal kt-modal-center" data-kt-modal="true" id="page-modal" data-kt-modal-backdrop-static="true">
            </div>
            <main class="flex flex-col grow" id="content" role="content">
                <div class="kt-container-fluid">
                    @RenderBody()
                </div>
                <footer class="footer">
                    <div class="kt-container-fluid">
                        <div class="flex flex-col md:flex-row justify-center md:justify-between items-center gap-3 py-5">
                            <div class="flex order-2 md:order-1 gap-2 font-normal text-sm">
                                <span class="text-muted-foreground">
                                    <script>document.write(new Date().getFullYear());</script> -
                                </span>
                                <a class="text-secondary-foreground hover:text-primary">
                                    Andon
                                </a>
                            </div>
                        </div>
                    </div>
                </footer>
            </main>
        </div>
    </div>

    <div id="global-messages" style="display:none"
         data-entry-saved="Registro guardado correctamente."
         data-generic-error="Ocurrió un error, intenta de nuevo.">
    </div>

    <script src="~/Content/js/core.bundle.js?v=@MvcApplication.version"></script>
    <script src="~/Content/vendors/ktui/ktui.min.js?v=@MvcApplication.version"></script>
    <script src="~/Content/js/andon/global.js?v=@MvcApplication.version"></script>
</body>
</html>
